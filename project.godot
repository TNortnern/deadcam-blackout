[physics]

common/physics_interpolation=true
common/max_physics_steps_per_frame=2
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.windows="d3d12"
rendering_device/driver.macos="metal"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/screen_space_aa=0
scaling_3d/mode=0
scaling_3d/scale=1.0
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=1
lights_and_shadows/positional_shadow/atlas_quadrant_1_subdiv=2
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=3
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
reflections/reflection_atlas/reflection_size=256
reflections/reflection_atlas/reflection_count=8
environment/ssao/quality=1
environment/ssao/half_size=true
environment/ssil/quality=1
environment/ssil/half_size=true
environment/glow/upscale_mode=1
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=36
environment/volumetric_fog/use_filter=1
textures/default_filters/anisotropic_filtering_level=3
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
environment/subsurface_scattering/subsurface_scattering_quality=0
global_illumination/gi/use_half_resolution=true
global_illumination/voxel_gi/quality=0
mesh_lod/lod_change/threshold_pixels=1.5
occlusion_culling/use_occlusion_culling=true
occlusion_culling/use_occlusion_culling.web=false
